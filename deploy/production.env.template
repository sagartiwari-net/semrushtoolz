APP_NAME=Semrushtoolz
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://semrushtoolz.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# MySQL (cPanel / hosting)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=semrushtoolzbd
DB_USERNAME=SemrushToolzBD
DB_PASSWORD=CHANGE_ME
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_FROM_ADDRESS="noreply@semrushtoolz.com"
MAIL_FROM_NAME="${APP_NAME}"

# Mail Panel (Admin → Email Setup can override)
MAIL_PANEL_ENABLED=true
MAIL_PANEL_URL=
MAIL_PANEL_API_KEY=

VITE_APP_NAME="${APP_NAME}"

# Payments — also configurable in Admin → Payment Integration
PAYPAL_MODE=live

# Tool access (set strong secrets in production)
# GO_PROXY_URL=
# GO_PROXY_API_KEY=
# TOOL_SECRET_SEMRUSH=
# TOOL_SECRET_AHREFS=
# Bar2 membership check: https://semrushtoolz.com/tm-check.php
# TM_CHECK_SECRET=pick-a-long-random-secret

# Security — IP + device fingerprint (works behind Cloudflare)
SECURITY_MAX_IPS_WARNING_HOUR=3
SECURITY_MAX_IPS_BLOCK_HOUR=5
SECURITY_MIN_DEVICES_WARNING=2
SECURITY_MIN_DEVICES_BLOCK=2
SECURITY_AUTO_BLOCK=true
