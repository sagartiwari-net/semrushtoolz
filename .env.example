APP_NAME=Semrushtoolz
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# For production with phpMyAdmin, switch to MySQL:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=semrushtoolzbd
# DB_USERNAME=SemrushToolzBD
# DB_PASSWORD=your_password
# DB_CHARSET=utf8mb4
# DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@semrushtoolz.com"
MAIL_FROM_NAME="${APP_NAME}"

# Mail Panel (transactional email)
MAIL_PANEL_ENABLED=false
MAIL_PANEL_URL=
MAIL_PANEL_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Payments
UPI_ID=semrushtoolz@paytm
UPI_NAME=Semrushtoolz
OFFLINE_WHATSAPP=919876543210
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_PRODUCT_ID=
PAYPAL_MODE=sandbox

# UPI auto-verify (optional — leave blank for manual admin approval)
# UPI_IMAP_HOST=imap.gmail.com
# UPI_IMAP_USERNAME=payments@yourdomain.com
# UPI_IMAP_PASSWORD=

# Go Proxy (tool access — same handshake as route_tool.php)
# TOOL_HANDSHAKE_USERNAME_FIELD=email
# TOOL_SECRET_SEMRUSH=toolsmandi_recloudsemrush_secret_xyz123
# TOOL_SECRET_AHREFS=prideref_ahrefs_secret_xyz123
# TOOL_EXPORT_URL_SEMRUSH=https://6.semrush.com.in/analytics/overview/?searchType=domain
# Map Laravel plan slugs → aMember product IDs (comma-separated)
# PLAN_PRODUCT_IDS_SEMRUSH=1
# PLAN_PRODUCT_IDS_COMBO=1,2,3

# Affiliate
AFFILIATE_COMMISSION_RATE=0.20
AFFILIATE_MIN_PAYOUT=500

# Security — account sharing (free: IP + browser fingerprint, Cloudflare-safe)
SECURITY_MAX_IPS_WARNING_HOUR=3
SECURITY_MAX_IPS_BLOCK_HOUR=5
SECURITY_MIN_DEVICES_WARNING=2
SECURITY_MIN_DEVICES_BLOCK=2
SECURITY_AUTO_BLOCK=true
SECURITY_ACTIVITY_LOG_INTERVAL=5
